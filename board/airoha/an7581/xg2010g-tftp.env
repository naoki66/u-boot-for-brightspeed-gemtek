
# ---------------------------------------------------------------------------
# TFTP rescue helpers and boot menu
#
# The web recovery server lives in U-Boot's lwIP stack and can be unavailable
# (bad port, torn-down Ethernet, or an image that no longer boots).  These
# helpers drive the same writes from the serial console over TFTP instead, so
# a bricked board is still recoverable without a NAND programmer.  The flow is
# the vendor U-Boot's (boot_tftp_write_bl2 / mtd_write_bl2):
#
#   * stage the image in RAM with tftpboot
#   * erase the target region
#   * write it with 'mtd write'
#   * READ IT BACK and compare with 'cmp.b'  <- never skipped
#
# Nothing here runs automatically; every helper is only reachable through the
# boot menu or by typing 'run <name>' at the U-Boot prompt.
# ---------------------------------------------------------------------------

net_init=ethact eth0 ; setenv autoload no ; setenv autostart no

# --- 1. full mtd0 bootloader image (with its own 0x800 prefix) --------------
# This is the normal path: it can restore the vendor prefix or an erased
# prefix, either of which the BootROM accepts.  A zero-filled prefix is not
# accepted.
tftp_flash=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (itest.l ${filesize} -eq ${tftpboot_size}) && (mtd erase bootloader) && (mtd write bootloader ${tftpboot_addr} 0 ${tftpboot_size}) && (mtd read bootloader ${tftpverify_addr} 0 ${tftpboot_size}) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} ${tftpboot_size}) && (echo Image written and read-back verified.) || (echo FAILED - nothing further was written.)

# --- 2. preloader / Boot ROM bl2 image -------------------------------------
# For an image that starts with its own 0x800 leading area (for example the
# vendor an7581-gemtek-xg2010g-preloader.bin), the payload has to sit at
# offset 0x800.  iret builds the 0x20000 staging buffer with 0xFF, which is
# exactly what the vendor helper does with 'mw.b $loadaddr 0xff 0x20000', then
# copies the file in at +0x800.
iret=setexpr tftp_bl2_dst ${tftpboot_addr} + 0x800 ; mw.b ${tftpboot_addr} 0xff ${tftpboot_bl2_size} ; cp.b ${tftp_bl2_dst} ${tftpboot_addr} 0
tftp_flash_bl2=(tftpboot ${tftp_bl2_dst} ${tftpboot_file}) && (itest.l ${filesize} -le 0x1f800) && (run iret) && (mtd erase bootloader) && (mtd write bootloader ${tftpboot_addr} 0 ${tftpboot_bl2_size}) && (mtd read bootloader ${tftpverify_addr} 0 ${tftpboot_bl2_size}) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} ${tftpboot_bl2_size}) && (echo BL2 written and read-back verified.) || (echo FAILED - nothing further was written.)

# --- 3. system firmware into the UBI 'fit' volume --------------------------
tftp_flash_fit=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (ubi part ubi) && (ubi check fit) && (ubi write ${tftpboot_addr} fit ${filesize}) && (ubi read ${tftpverify_addr} fit ${filesize}) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} ${filesize}) && (echo Firmware written and read-back verified.) || (echo FAILED - nothing further was written.)

tftp_flash_uenv=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (itest.l ${filesize} -eq 0x200000) && (mtd erase uenv) && (mtd write uenv ${tftpboot_addr} 0 0x200000) && (mtd read uenv ${tftpverify_addr} 0 0x200000) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} 0x200000) && (echo uenv written and read-back verified.) || (echo FAILED - nothing further was written.)
tftp_flash_dsd=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (itest.l ${filesize} -eq 0x200000) && (mtd erase dsd) && (mtd write dsd ${tftpboot_addr} 0 0x200000) && (mtd read dsd ${tftpverify_addr} 0 0x200000) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} 0x200000) && (echo dsd written and read-back verified.) || (echo FAILED - nothing further was written.)

# --- 4. manual address mode ------------------------------------------------
# Writes ${tftpboot_file} to ${tftpboot_part} at partition offset
# ${tftpboot_ofs}, ${tftpboot_len} bytes, then reads that back and compares.
# There are deliberately NO safety checks on the target: this is the escape
# hatch for repairing a layout the fixed helpers do not cover.  Set the
# variables first, and get the partition name and offset right:
#
#   setenv tftpboot_file my-image.bin
#   setenv tftpboot_part bootloader
#   setenv tftpboot_ofs  0x800
#   setenv tftpboot_len  0x200000
#   run tftp_flash_manual
#
# 'mtd list' and 'mtd read <part> ${tftpverify_addr} 0 0x100' help confirm the
# target before writing.  A wrong region can destroy calibration data, so back
# it up first (Web recovery / Backup page downloads uenv and dsd).
tftp_flash_manual=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (itest.l ${filesize} -le ${tftpboot_len}) && (echo Writing ${tftpboot_part} offset ${tftpboot_ofs} length ${tftpboot_len}) && (mtd erase ${tftpboot_part} ${tftpboot_ofs} ${tftpboot_len}) && (mtd write ${tftpboot_part} ${tftpboot_addr} ${tftpboot_ofs} ${tftpboot_len}) && (mtd read ${tftpboot_part} ${tftpverify_addr} ${tftpboot_ofs} ${tftpboot_len}) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} ${tftpboot_len}) && (echo Manual write done and read-back verified.) || (echo FAILED - check tftpboot_part / tftpboot_ofs / tftpboot_len.)

# --- boot menu -------------------------------------------------------------
# Reachable with 'run boot_menu' (or 'bootmenu') at the U-Boot prompt.  The
# default bootcmd deliberately keeps its automatic 'run boot_ubi ||
# http_recovery' fallback, so the menu is opt-in and an unattended board still
# lands in web recovery when the UBI image cannot boot.
boot_menu=setenv bootmenu_title "U-Boot XG2010G" ; setenv bootmenu_delay 3 ; setenv bootmenu_default 0 ; bootmenu
bootmenu_title=U-Boot XG2010G
bootmenu_default=0
bootmenu_0=Boot system=run boot_ubi
bootmenu_1=Web recovery=run http_recovery
bootmenu_2=Flash mtd0 image via TFTP=run net_init ; setenv tftpboot_file ; echo Set tftpboot_file, then run tftp_flash
bootmenu_3=Flash BL2/preloader via TFTP=run net_init ; setenv tftpboot_file ; echo Set tftpboot_file, then run tftp_flash_bl2
bootmenu_4=Flash system firmware via TFTP=run net_init ; setenv tftpboot_file ; echo Set tftpboot_file, then run tftp_flash_fit
bootmenu_5=Manual NAND write via TFTP=run net_init ; echo Set tftpboot_file/tftpboot_part/tftpboot_ofs/tftpboot_len, then run tftp_flash_manual
bootmenu_6=Show storage information=mtd list ; ubi part ubi ; ubi info l
bootmenu_7=Show flash environment=printenv tftpboot_file tftpboot_part tftpboot_ofs tftpboot_len ipaddr serverip
bootmenu_8=Reboot=reset
