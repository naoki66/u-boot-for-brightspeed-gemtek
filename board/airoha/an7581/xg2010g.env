loadaddr=0x81800000
bootconf=config-1
recovery_trigger=0
recovery_button_timeout=3
bootargs=sdram_conf=0x00108893 vendor_name=ECONET Technologies Corp. product_name=xPON ONU ubi.mtd=ubi snmp_sysobjid=1.2.3.4.5 country_code=ff ether_gpio=0c power_gpio=1515 dsl_gpio=0b internet_gpio=02 multi_upgrade_gpio=0b020400000000000000000000000000 onu_type=71 qdma_init=69bb console=ttyS0,115200n8 earlycon bootflag=0 serdes_sel=0 serdes_pon=000 serdes_ethernet=411 serdes_wifi1=005 serdes_wifi2=413 serdes_usb1=111 serdes_usb2=000 ubi.block=0,fit root=/dev/fit0 rootwait ramdisk_size=65536 rdinit=/sbin/init
boot_ubi=ubi part ubi && run boot_production
boot_production=run ubi_read_production && bootm ${loadaddr}#${bootconf}
# Normal boot keeps the automatic recovery fallback.  The boot menu is opt-in
# ('run boot_menu' at the prompt, or a bootmenu_* entry from anyone who wants
# it as default) so an unattended board still lands in web recovery when the
# UBI image cannot boot.
bootcmd=run boot_ubi || http_recovery
ubi_read_production=ubi read ${loadaddr} fit
recovery_addr=0x81800000
recovery_mtd=fit
recovery_ubi_part=ubi
recovery_mtd_uboot=bootloader
recovery_size_uboot=0x200000
# Network defaults for the TFTP rescue helpers.  These match the vendor
# U-Boot (ipaddr 192.168.0.1, serverip 192.168.0.254) and the addresses the
# flashing guide documents, and they are only defaults: an 'ipaddr' already
# saved in the uenv partition wins.
ipaddr=192.168.0.1
netmask=255.255.255.0
serverip=192.168.0.254
# Staging and verify buffers for TFTP.  Deliberately NOT $loadaddr: recovery
# uploads are staged at recovery_addr (0x81800000), so a separate buffer keeps
# a TFTP transfer from colliding with an in-flight HTTP upload.
tftpboot_addr=0x90000000
tftpverify_addr=0x94000000
# Size of a complete mtd0 image (0x800 prefix + FIP + 0xFF padding).
tftpboot_size=0x200000
# Serial-console rescue path over TFTP (works even if lwIP web recovery does
# not come up) plus the boot menu that exposes it.  The shared file lives under
# the env/airoha/ directory below include/ because the Makefile preprocesses the
# ASSEMBLED environment (generated into the generated/env.txt path), so a file
# named here has to resolve through the -I paths; the "-I include" entry covers
# env/...  A quoted relative name would resolve against the build root and fail
# with "No such file".
#
# Careful: this whole file is fed to CPP before awk, so a comment line must
# never put a preprocessor keyword right after the leading hash.  A line such as
# "# <kw>/foo" is parsed as a directive and breaks the build; write the keyword
# in the middle of a sentence instead.
#include <env/airoha/an7581-tftp.env>
