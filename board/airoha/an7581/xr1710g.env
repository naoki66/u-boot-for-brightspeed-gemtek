loadaddr=0x81800000
bootconf=config-1
recovery_trigger=0
recovery_button_timeout=3
bootargs=console=ttyS0,115200n8 earlycon ubi.block=0,fit root=/dev/fit0 rootwait rdinit=/sbin/init
boot_ubi=ubi part ubi && run boot_production
boot_production=run ubi_read_production && bootm ${loadaddr}#${bootconf}
bootcmd=run boot_ubi || http_recovery
ubi_read_production=ubi read ${loadaddr} fit
recovery_addr=0x81800000
recovery_mtd=fit
recovery_ubi_part=ubi
recovery_mtd_uboot=bootloader
recovery_size_uboot=0x200000
# Network defaults for the TFTP rescue helpers (see xg2010g.env / the included
# file).  Same convention: these are only defaults, an 'ipaddr' already saved
# in the uenv partition wins.
ipaddr=192.168.0.1
netmask=255.255.255.0
serverip=192.168.0.254
tftpboot_addr=0x90000000
tftpverify_addr=0x94000000
tftpboot_size=0x200000
tftpboot_bl2_size=0x20000
# Serial-console rescue path over TFTP plus the boot menu that exposes it.
# Shared by both AN7581 boards; it only references partition labels that are
# common to them (bootloader / uenv / dsd / ubi).
#include "xg2010g-tftp.env"
