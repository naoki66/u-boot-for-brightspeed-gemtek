
# ---------------------------------------------------------------------------
# TFTP rescue helpers and boot menu
#
# The web recovery server lives in U-Boot's lwIP stack and can be unavailable
# (bad port, torn-down Ethernet, or an image that no longer boots).  These
# helpers drive the same writes from the serial console over TFTP instead, so
# a bricked board is still recoverable without a NAND programmer.  Each helper
# follows the skeleton of the vendor U-Boot's serial writers
# (boot_tftp_write_bl2 / mtd_write_bl2, quoted in doc/board/airoha/xg2010g.rst).
#
#   * stage the image in RAM with tftpboot
#   * erase the target region
#   * write it with 'mtd write'
#   * READ IT BACK and compare with 'cmp.b'  <- never skipped
#
# The last step is our addition: the vendor helper stops after 'mtd write'.
# It is copied from the vendor's UBI helpers (ubi_verify_fip /
# ubi_verify_production), which do compare, and it is what catches a NAND write
# that reported success but did not happen.
#
# There is deliberately no "BL2 only" helper here.  The boot chain in mtd0 is a
# single merged FIP spanning about 3.6 eraseblocks, so writing just the first
# 0x20000 bytes would drop BL31/BL33 and produce a board that neither boots nor
# returns to the BootROM's serial X mode.  The vendor can do that because its
# second stage lives in a separate flash region; this layout cannot.  Use
# tftp_flash with a complete mtd0 image instead.
#
# Nothing here runs automatically; every helper is only reachable through the
# boot menu or by typing 'run <name>' at the U-Boot prompt.
# ---------------------------------------------------------------------------

net_init=ethact eth0 ; setenv autoload no ; setenv autostart no

# --- 1. full mtd0 bootloader image (with its own 0x800 prefix) --------------
# This is the normal path: it can restore the vendor prefix or an erased
# prefix, either of which the BootROM accepts.  A zero-filled prefix is not
# accepted.
tftp_flash=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (itest.l ${filesize} -eq ${tftpboot_size}) && (mtd erase bootloader) && (mtd write bootloader ${tftpboot_addr} 0 ${tftpboot_size}) && (mtd read bootloader ${tftpverify_addr} 0 ${tftpboot_size}) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} ${tftpboot_size}) && (echo Image written and read-back verified.) || (echo FAILED - nothing further was written.)

# --- 2. system firmware into the UBI 'fit' volume --------------------------
tftp_flash_fit=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (ubi part ubi) && (ubi check fit) && (ubi write ${tftpboot_addr} fit ${filesize}) && (ubi read ${tftpverify_addr} fit ${filesize}) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} ${filesize}) && (echo Firmware written and read-back verified.) || (echo FAILED - nothing further was written.)

tftp_flash_uenv=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (itest.l ${filesize} -eq 0x200000) && (mtd erase uenv) && (mtd write uenv ${tftpboot_addr} 0 0x200000) && (mtd read uenv ${tftpverify_addr} 0 0x200000) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} 0x200000) && (echo uenv written and read-back verified.) || (echo FAILED - nothing further was written.)
tftp_flash_dsd=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (itest.l ${filesize} -eq 0x200000) && (mtd erase dsd) && (mtd write dsd ${tftpboot_addr} 0 0x200000) && (mtd read dsd ${tftpverify_addr} 0 0x200000) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} 0x200000) && (echo dsd written and read-back verified.) || (echo FAILED - nothing further was written.)

# --- 3. manual address mode ------------------------------------------------
# Writes ${tftpboot_file} to ${tftpboot_part} at partition offset
# ${tftpboot_ofs}, ${tftpboot_len} bytes, then reads that back and compares.
# There are deliberately NO safety checks on the target: this is the escape
# hatch for repairing a layout the fixed helpers do not cover.
#
#   setenv tftpboot_file my-image.bin
#   setenv tftpboot_part bootloader
#   setenv tftpboot_ofs  0
#   setenv tftpboot_len  0x200000
#   run tftp_flash_manual
#
# ${tftpboot_ofs} is relative to the START OF THE PARTITION, not an absolute
# chip offset.  'mtd read/write' resolve the partition with
# get_mtd_device_nm(<part>) and measure from there, while 'mtd list' prints
# ABSOLUTE addresses -- so do not copy the number from 'mtd list' into
# tftpboot_ofs.  To write the uenv partition use part=uenv ofs=0, NOT
# part=bootloader ofs=0x200000.
#
# Alignment, enforced by cmd/mtd.c:
#   erase: offset and length must be eraseblock aligned (0x20000 here)
#   read/write: offset must be page aligned (0x800 here); a length that is not
#               page aligned is rounded up with a warning
#
# Confirm the target before writing:
#   mtd list
#   ubi part ubi ; ubi info l
#   mtd read ${tftpboot_part} ${tftpverify_addr} 0 0x100
#
# A wrong region can destroy calibration data irrecoverably, so download the
# factory partitions and the whole flash from the Web recovery Backup page
# first.
tftp_flash_manual=(tftpboot ${tftpboot_addr} ${tftpboot_file}) && (itest.l ${filesize} -le ${tftpboot_len}) && (echo Writing ${tftpboot_part} partition-relative offset ${tftpboot_ofs} length ${tftpboot_len}) && (mtd erase ${tftpboot_part} ${tftpboot_ofs} ${tftpboot_len}) && (mtd write ${tftpboot_part} ${tftpboot_addr} ${tftpboot_ofs} ${tftpboot_len}) && (mtd read ${tftpboot_part} ${tftpverify_addr} ${tftpboot_ofs} ${tftpboot_len}) && (cmp.b ${tftpboot_addr} ${tftpverify_addr} ${tftpboot_len}) && (echo Manual write done and read-back verified.) || (echo FAILED - check tftpboot_part / tftpboot_ofs / tftpboot_len, remember the offset is partition-relative.)

# --- boot menu -------------------------------------------------------------
# Reachable with 'run boot_menu' (or 'bootmenu') at the U-Boot prompt.  The
# default bootcmd deliberately keeps its automatic 'run boot_ubi ||
# http_recovery' fallback, so the menu is opt-in and an unattended board still
# lands in web recovery when the UBI image cannot boot.
boot_menu=setenv bootmenu_title U-Boot XG2010G ; setenv bootmenu_delay 3 ; setenv bootmenu_default 0 ; bootmenu
bootmenu_title=U-Boot XG2010G
bootmenu_default=0
bootmenu_0=Boot system=run boot_ubi
bootmenu_1=Web recovery=run http_recovery
bootmenu_2=Flash mtd0 image via TFTP=run net_init ; setenv tftpboot_file ; echo Set tftpboot_file, then run tftp_flash
bootmenu_3=Flash system firmware via TFTP=run net_init ; setenv tftpboot_file ; echo Set tftpboot_file, then run tftp_flash_fit
bootmenu_4=Manual NAND write (set vars first)=run tftp_help
bootmenu_5=Show storage information=mtd list ; ubi part ubi ; ubi info l
bootmenu_6=Show flash environment=run tftp_env
bootmenu_7=Reboot=reset

# Static help for the manual helper.
#
# This text deliberately does NOT reference ${tftpboot_part} and friends: 'run'
# expands variables before executing, so a placeholder would print as an empty
# string instead of showing the variable name.  To see the current values use
# 'run tftp_env' (see below).  Both variables are also free of quote characters
# because 'setenv' joins its argv with spaces and does not strip quotes
# (env/common.c), so a quoted value would keep its quotes.
tftp_help=echo ; echo Manual NAND write - set these, then run tftp_flash_manual ; echo ; echo   tftpboot_file  name of the image on the TFTP server ; echo   tftpboot_part  a partition label from the mtd list command, e.g. bootloader ; echo   tftpboot_ofs   offset RELATIVE to that partition start, NOT an absolute address ; echo   tftpboot_len   number of bytes to erase and write ; echo ; echo Use the Show flash environment entry to see the values currently set. ; echo ; echo WARNING - no target checks are performed. Back up uenv and dsd first. ; echo ; echo Example: ; echo   setenv tftpboot_file my-image.bin ; echo   setenv tftpboot_part bootloader ; echo   setenv tftpboot_ofs 0 ; echo   setenv tftpboot_len 0x200000 ; echo   run net_init ; echo   run tftp_flash_manual
tftp_env=echo tftpboot_file = ${tftpboot_file} ; echo tftpboot_part = ${tftpboot_part} ; echo tftpboot_ofs = ${tftpboot_ofs} ; echo tftpboot_len = ${tftpboot_len} ; echo tftpboot_addr = ${tftpboot_addr} ; echo tftpverify_addr = ${tftpverify_addr} ; echo ipaddr = ${ipaddr} ; echo serverip = ${serverip}
